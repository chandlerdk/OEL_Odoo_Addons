<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Core draws this help link only for a documentation URL. An MCP setting shows its help text on it. -->
    <t t-inherit="web.SearchableSetting" t-inherit-mode="extension">
        <xpath expr="//FormLabel" position="after"><a
                t-if="props.title and props.fieldName and props.fieldName.startsWith('mcp_')"
                class="o_doc_link me-2"
                t-att-title="props.title"
            /></xpath><xpath
            expr="//div[hasclass('o_setting_left_pane')]"
            position="attributes"
        ><attribute
                name="t-att-data-tooltip"
            >props.fieldName and props.fieldName.startsWith('mcp_') ? false : props.title</attribute></xpath><xpath
            expr="//div[hasclass('o_setting_right_pane')]"
            position="attributes"
        ><attribute
                name="t-att-data-tooltip"
            >props.fieldName and props.fieldName.startsWith('mcp_') ? false : props.title</attribute></xpath>
    </t>
</templates>
