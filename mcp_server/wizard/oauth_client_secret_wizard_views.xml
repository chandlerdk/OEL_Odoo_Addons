<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mcp_oauth_client_secret_wizard_view_form" model="ir.ui.view">
        <field name="name">mcp.oauth.client.secret.wizard.form</field>
        <field name="model">mcp.oauth.client.secret.wizard</field>
        <field name="arch" type="xml">
            <form string="Confidential OAuth Client">
                <div class="mb-3" invisible="client_id">
                    Create an OAuth client with a client secret, for example for
                    a Microsoft 365 Copilot plugin that you register in the Teams
                    Developer Portal.
                </div>
                <div class="mb-3" invisible="not client_id">
                    A new secret replaces the current one. The program that uses
                    this client stops working until you enter the new secret
                    there.
                </div>
                <group>
                    <field
                        name="client_id"
                        readonly="1"
                        force_save="1"
                        invisible="not client_id"
                    />
                    <field
                        name="client_name"
                        invisible="client_id"
                        required="not client_id"
                        placeholder="e.g. Microsoft 365 Copilot"
                    />
                    <field
                        name="redirect_uris"
                        invisible="client_id"
                        required="not client_id"
                        placeholder="https://teams.microsoft.com/api/platform/v1.0/oAuthRedirect"
                    />
                    <field
                        name="scope"
                        invisible="client_id"
                        required="not client_id"
                    />
                </group>
                <footer>
                    <button
                        name="action_create"
                        string="Create"
                        type="object"
                        class="btn-primary"
                        invisible="client_id"
                        data-hotkey="q"
                    />
                    <button
                        name="action_regenerate"
                        string="Regenerate Secret"
                        type="object"
                        class="btn-primary"
                        invisible="not client_id"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mcp_oauth_client_secret_wizard" model="ir.actions.act_window">
        <field name="name">Confidential OAuth Client</field>
        <field name="res_model">mcp.oauth.client.secret.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mcp_oauth_client_secret_wizard_view_form" />
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('mcp_server.group_mcp_admin'))]" />
    </record>

    <record id="mcp_oauth_client_secret_show_view_form" model="ir.ui.view">
        <field name="name">mcp.oauth.client.secret.show.form</field>
        <field name="model">mcp.oauth.client.secret.show</field>
        <field name="arch" type="xml">
            <form string="Client Secret">
                <sheet>
                    <h3 class="fw-bold">Write down the client secret</h3>
                    <p>
                        Enter the client ID and the client secret in the program
                        that uses this client, for example the Teams Developer
                        Portal.
                    </p>
                    <group>
                        <field
                            name="client_identifier"
                            widget="CopyClipboardChar"
                            readonly="1"
                        />
                        <field
                            name="client_secret"
                            widget="CopyClipboardChar"
                            readonly="1"
                        />
                    </group>
                    <p class="alert alert-warning" role="alert">
                        You see the secret only now. If you lose it, give the
                        client a new secret with Regenerate Secret.
                    </p>
                    <footer>
                        <button
                            string="Done"
                            class="btn-primary"
                            special="cancel"
                            data-hotkey="x"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
